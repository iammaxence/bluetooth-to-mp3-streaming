# Prepare the Bluetooth controller for reconnection to a paired phone.

# Declare service dependencies and startup ordering.
[Unit]
Description=Prepare RadioNav Bluetooth for the paired phone
Requires=bluetooth.service bluealsa.service
After=bluetooth.service bluealsa.service
Before=radionav-audio.service
PartOf=radionav-usb.target

# Define runtime commands and process lifecycle settings.
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/radionav-usb/bluetooth_ready.py
Restart=on-failure
RestartSec=3
TimeoutStartSec=120
